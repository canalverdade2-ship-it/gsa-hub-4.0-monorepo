VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Bootstrap-only values. Set in your local shell when running
# `npm run bootstrap:admin`, then remove them; these are never VITE_* settings.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# BOOTSTRAP_ADMIN_PASSWORD=

# Edge Function secrets are configured with `supabase secrets set`, not here.
# APP_ORIGIN=https://your-domain.example
# PAYMENT_CONFIG_ENCRYPTION_KEY=
# GOVBR_SIGNATURE_CLIENT_ID=
# GOVBR_SIGNATURE_CLIENT_SECRET=
# GOVBR_SIGNATURE_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/govbr-signature
# GOVBR_SIGNATURE_AUTHORIZE_URL=https://cas.staging.iti.br/oauth2.0/authorize
# GOVBR_SIGNATURE_TOKEN_URL=https://cas.staging.iti.br/oauth2.0/token
# GOVBR_SIGNATURE_API_BASE_URL=https://assinatura-api.staging.iti.br
# GOVBR_SIGNATURE_SCOPE=sign govbr
# CLIENT_CONTRACTS_URL=https://your-domain.example/gsa3-supabase/cliente/contratos
