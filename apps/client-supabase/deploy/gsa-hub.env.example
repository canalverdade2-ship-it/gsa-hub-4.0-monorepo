NODE_ENV=production
GSA_PORT=4180
GSA_DATA_DIR=/var/lib/gsa-hub/data
# The authenticated payment-settings screen persists provider changes here.
GSA_RUNTIME_ENV_FILE=/var/lib/gsa-hub/gsa-hub.runtime.env

# First production administrator. Use a unique password with at least 10 characters.
# These values are consumed only on the first boot of a new production database.
GSA_BOOTSTRAP_ADMIN_NAME=
GSA_BOOTSTRAP_ADMIN_EMAIL=
GSA_BOOTSTRAP_ADMIN_PASSWORD=

# Company profile shown by the authenticated panels.
GSA_COMPANY_NAME=
GSA_COMPANY_TAX=
GSA_COMPANY_EMAIL=
GSA_COMPANY_PHONE=
GSA_COMPANY_DESCRIPTION=

# InfinitePay — preencha somente no servidor
INFINITEPAY_API_KEY=
INFINITEPAY_HANDLE=gsahub_solucoesdigital
INFINITEPAY_ENABLED=false
INFINITEPAY_REDIRECT_URL=https://app.example.com/cliente/faturas
INFINITEPAY_WEBHOOK_URL=https://app.example.com/api/infinitepay/webhook

# Gov.br direto — deixe vazio se o botão usar o endereço externo configurado
GOVBR_SIGNATURE_CLIENT_ID=
GOVBR_SIGNATURE_CLIENT_SECRET=
GOVBR_SIGNATURE_REDIRECT_URI=
GOVBR_SIGNATURE_AUTHORIZE_URL=https://cas.staging.iti.br/oauth2.0/authorize
GOVBR_SIGNATURE_TOKEN_URL=https://cas.staging.iti.br/oauth2.0/token
GOVBR_SIGNATURE_API_BASE_URL=https://assinatura-api.staging.iti.br
GOVBR_SIGNATURE_SCOPE=sign govbr
