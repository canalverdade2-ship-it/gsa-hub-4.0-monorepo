[Unit]
Description=Backup do SQLite do GSA HUB 3.0
After=gsa-hub.service

[Service]
Type=oneshot
User=gsa-hub
Group=gsa-hub
WorkingDirectory=/var/www/gsa-hub
Environment=GSA_DB_FILE=/var/lib/gsa-hub/data/gsa3.sqlite
Environment=GSA_BACKUP_DIR=/var/backups/gsa-hub
Environment=GSA_BACKUP_RETENTION=14
ExecStart=/opt/node24/bin/node /usr/local/lib/gsa-hub/gsa-hub-backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/gsa-hub

[Install]
WantedBy=multi-user.target
