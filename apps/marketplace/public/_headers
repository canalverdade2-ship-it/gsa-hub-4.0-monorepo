# Cache de longa duração para arquivos estáticos compilados com hash
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Configurações de segurança e SPA
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Evita cache do HTML principal para garantir que os clientes sempre recebam a versão mais recente
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
